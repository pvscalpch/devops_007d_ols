# Plantilla de variables de entorno para docker-compose.
#
# Copiar a .env y reemplazar los valores:
#     cp .env.example .env
#
# El archivo .env NO se versiona: esta en .gitignore.

# --- Base de datos ---
MYSQL_ROOT_PASSWORD=cambiar-esta-clave
MYSQL_DATABASE=db_auth

# --- Aplicacion ---
# Clave de firma de los JWT. Minimo 32 caracteres: el algoritmo HS256
# exige 256 bits y con menos la aplicacion no arranca.
# Generar una con:  openssl rand -base64 48
JWT_SECRET=cambiar-por-una-clave-de-al-menos-32-caracteres

# Puerto por el que se publica el servicio en la maquina anfitriona
APP_PORT=8090

# Etiqueta de la imagen a desplegar. En local se deja vacia para que
# use "latest"; el pipeline la fija al SHA del commit para que el
# despliegue sea trazable.
# IMAGE_TAG=latest
